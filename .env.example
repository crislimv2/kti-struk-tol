# Opsional: Supabase untuk riwayat lintas perangkat (app tetap jalan tanpa ini, riwayat di localStorage)
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Nama printer Windows tujuan cetak RAW (lihat Settings > Printers). Default: POS80
STRUK_PRINTER=POS80
